<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lily's Junk DFW</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background-color: #f4f4f4;
      color: #222;
      line-height: 1.6;
    }

    header {
      background: #ff4fa3;
      color: white;
      padding: 30px 20px;
      text-align: center;
    }

    header h1 {
      font-size: 3rem;
    }

    header p {
      font-size: 1.2rem;
      margin-top: 10px;
    }

    nav {
      background: #222;
      padding: 15px;
      text-align: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 15px;
      font-weight: bold;
    }

    .hero {
      background: white;
      padding: 50px 20px;
      text-align: center;
    }

    .hero h2 {
      font-size: 2.2rem;
      margin-bottom: 15px;
    }

    .hero p {
      max-width: 700px;
      margin: auto;
      font-size: 1.1rem;
    }

    .products {
      padding: 50px 20px;
    }

    .products h2 {
      text-align: center;
      margin-bottom: 40px;
      font-size: 2rem;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .product-card {
      background: white;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      transition: 0.3s;
    }

    .product-card:hover {
      transform: translateY(-5px);
    }

    .product-card h3 {
      margin-bottom: 10px;
      color: #ff4fa3;
    }

    .price {
      font-size: 1.3rem;
      font-weight: bold;
      margin: 10px 0;
    }

    .contact {
      background: #222;
      color: white;
      padding: 50px 20px;
      text-align: center;
    }

    .contact h2 {
      margin-bottom: 20px;
      font-size: 2rem;
    }

    .contact p {
      margin: 10px 0;
    }

    footer {
      background: #111;
      color: #aaa;
      text-align: center;
      padding: 15px;
      font-size: 0.9rem;
    }

    .button {
      display: inline-block;
      margin-top: 15px;
      background: #ff4fa3;
      color: white;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
    }

    .button:hover {
      background: #ff2e8b;
    }
  </style>
</head>

<body>

  <header>
    <h1>Lily's Junk DFW</h1>
    <p>Name Brand Deals at 50¢ on the Dollar!</p>
  </header>

  <nav>
    <a href="#products">Products</a>
    <a href="#contact">Contact</a>
  </nav>

  <section class="hero">
    <h2>Affordable Name Brand Merchandise</h2>
    <p>
      Welcome to Lily's Junk DFW! We specialize in discounted retail merchandise,
      liquidation items, overstock products, and hidden gems — all at incredible prices.
    </p>

    <a class="button" href="#products">Shop Deals</a>
  </section>

  <section class="products" id="products">
    <h2>Featured Products</h2>

    <div class="product-grid">

      <div class="product-card">
        <h3>Nike Shoes</h3>
        <p>Brand new athletic footwear at liquidation prices.</p>
        <div class="price">$45</div>
      </div>

      <div class="product-card">
        <h3>Bluetooth Speakers</h3>
        <p>Portable speakers with premium sound quality.</p>
        <div class="price">$25</div>
      </div>

      <div class="product-card">
        <h3>Kitchen Appliances</h3>
        <p>Air fryers, blenders, and small appliances.</p>
        <div class="price">Starting at $30</div>
      </div>

      <div class="product-card">
        <h3>Designer Handbags</h3>
        <p>Fashion accessories and trendy styles.</p>
        <div class="price">$40</div>
      </div>

      <div class="product-card">
        <h3>Gaming Accessories</h3>
        <p>Headsets, controllers, and gaming gear.</p>
        <div class="price">$20</div>
      </div>

      <div class="product-card">
        <h3>Home Decor</h3>
        <p>Decorative items and furniture accents.</p>
        <div class="price">$15+</div>
      </div>

    </div>
  </section>

  <section class="contact" id="contact">
    <h2>Contact Lily's Junk DFW</h2>

    <p>Email: contact@lilysjunkdfw.com</p>
    <p>Phone: (555) 555-5555</p>
    <p>Dallas-Fort Worth Area, Texas</p>

    <a class="button" href="mailto:contact@lilysjunkdfw.com">
      Email Us
    </a>
  </section>

  <footer>
    © 2026 Lily's Junk DFW — All Rights Reserved
  </footer>

</body>
</html>
